@page
@model ZYC.VerbClass.Web.Modules.Academic.Pages.Academic.CourseParticipantManagerModel

@section Styles {
    <link rel="stylesheet" href="/css/admin-master-detail.css"/>
    <link rel="stylesheet" href="/css/academic-master-detail.css"/>
}

<div id="course-participant-manager-content" class="master-detail-page">
    <partial name="~/Pages/Academic/CourseParticipantManagerPartials/_CourseParticipantManagerContent.cshtml" model="Model.State"/>
</div>

@section Scripts {
    <script>
        (() => {
            const itemSelector = '[data-course-participant-offering-item]';

            function setSelectedItem(offeringId) {
                document.querySelectorAll(itemSelector).forEach(item => {
                    item.classList.toggle('is-selected', item.dataset.offeringId === offeringId);
                });
            }

            document.addEventListener('click', event => {
                const item = event.target.closest(itemSelector);
                if (!item) {
                    return;
                }

                setSelectedItem(item.dataset.offeringId ?? '');
            });

            window.addEventListener('popstate', () => {
                const query = new URLSearchParams(window.location.search);
                setSelectedItem(query.get('OfferingId') ?? '');
            });

            document.addEventListener('DOMContentLoaded', () => {
                const query = new URLSearchParams(window.location.search);
                setSelectedItem(query.get('OfferingId') ?? '');

                const selected = document.querySelector('.academic-manager-item.is-selected');
                selected?.scrollIntoView({ block: 'nearest' });
            });
        })();
    </script>
}
