@model ZYC.VerbClass.Web.Modules.Academic.Pages.Academic.TimeTemplateManagerPartials.TimeTemplateInfoModel

<div class="academic-template-info">
    <section class="academic-template-info__summary">
        <div class="academic-template-info__title">
            <strong class="user-info__name">@Model.Name</strong>
            <span class="u-mono academic-template-info__code">@Model.Code</span>
        </div>
        <div class="academic-template-info__meta">
            <span class="tag">@Model.Periods.Length period(s)</span>
        </div>
        <div class="academic-template-info__actions">
            <button type="button"
                    hx-get="@Url.Page(null, "Edit", new { templateId = Model.Id })"
                    hx-target="#academic-time-template-manager-content"
                    hx-swap="innerHTML">
                Edit Template
            </button>
            <button type="button"
                    hx-get="@Url.Page(null, "Copy", new { templateId = Model.Id })"
                    hx-target="#academic-time-template-manager-content"
                    hx-swap="innerHTML">
                Copy Template
            </button>
            <button type="button"
                    hx-post="@Url.Page(null, "Delete", new { templateId = Model.Id })"
                    hx-target="#academic-time-template-manager-content"
                    hx-swap="innerHTML"
                    hx-confirm="Delete this template?">
                Delete Template
            </button>
        </div>
    </section>

    <div class="academic-template-info__sections">
        <section class="detail-section">
            <div class="detail-section__title">Template</div>
            <div class="kv-grid academic-template-info__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Code</div>
                    <div class="u-mono">@Model.Code</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Name</div>
                    <div>@Model.Name</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Periods</div>
                    <div>@Model.Periods.Length</div>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <div class="detail-section__title">Time Definition</div>
            <div class="academic-period-table-wrap">
                <table class="compact-table">
                    <thead>
                    <tr>
                        <th>Period</th>
                        <th>Label</th>
                        <th>Start</th>
                        <th>End</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var period in Model.Periods)
                    {
                        <tr>
                            <td>@period.PeriodNo</td>
                            <td>@period.Label</td>
                            <td class="u-mono">@period.StartTime</td>
                            <td class="u-mono">@period.EndTime</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
