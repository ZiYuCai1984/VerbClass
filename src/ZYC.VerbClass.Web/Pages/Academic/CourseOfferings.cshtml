@page
@model ZYC.VerbClass.Web.Pages.Academic.CourseOfferingsModel

@section Styles {
    <link rel="stylesheet" href="/css/admin-master-detail.css"/>
    <link rel="stylesheet" href="/css/academic-course-management.css"/>
}

<div class="shell__workspace">
    <header class="shell__workspace-header">
        <div class="page-heading">
            <h1 class="page-heading__title">Course Offerings</h1>
            <div class="page-heading__meta">
                Review created course offerings and open new course offerings.
            </div>
        </div>
    </header>

    <div class="shell__workspace-body">
        <div id="course-offerings-content" class="master-detail-page">
            <partial name="_CourseOfferingsContent" model="Model.State"/>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const itemSelector = '[data-course-offering-item]';

            function setSelectedItem(courseOfferingId) {
                document.querySelectorAll(itemSelector).forEach(item => {
                    item.classList.toggle('is-selected', item.dataset.courseOfferingId === courseOfferingId);
                });
            }

            function syncSelectedItem() {
                const query = new URLSearchParams(window.location.search);
                const selectedId = query.get('courseOfferingId') ?? '';
                setSelectedItem(selectedId);
            }

            document.addEventListener('click', event => {
                const item = event.target.closest(itemSelector);
                if (!item) {
                    return;
                }

                setSelectedItem(item.dataset.courseOfferingId ?? '');
            });

            window.addEventListener('popstate', syncSelectedItem);
            document.body.addEventListener('htmx:afterSwap', syncSelectedItem);

            syncSelectedItem();

            document.addEventListener('DOMContentLoaded', () => {
                const selected = document.querySelector('.course-offering-item.is-selected');
                selected?.scrollIntoView({ block: 'nearest' });
            });
        })();
    </script>
}
