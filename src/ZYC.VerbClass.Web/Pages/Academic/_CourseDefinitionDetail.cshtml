@model ZYC.VerbClass.Web.Pages.Academic.CourseDefinitionDetailModel

<div class="course-definition-detail">
    <div class="course-definition-detail__summary">
        <div class="course-definition-detail__title-row">
            <strong class="course-definition-detail__title">@Model.Name</strong>
            <span class="tag @(Model.IsActive ? "is-success" : "is-danger")">
                @(Model.IsActive ? "Active" : "Disabled")
            </span>
        </div>
        <div class="course-definition-detail__subtitle">
            <span class="u-mono">@Model.Code</span>
            @if (!string.IsNullOrWhiteSpace(Model.ShortName))
            {
                <span> · @Model.ShortName</span>
            }
        </div>
        <div class="course-definition-detail__meta">
            <span class="tag">@Model.OfferingCount offering(s)</span>
            <span class="tag">@Model.ActiveOfferingCount active/published</span>
            <span class="tag">@(Model.LockedOfferingCount == 0 ? "No locked offerings" : $"{Model.LockedOfferingCount} locked")</span>
        </div>
        <div class="course-definition-detail__actions">
            <button type="button"
                    hx-get="@Url.Page(null, "Edit", new { courseDefinitionId = Model.Id })"
                    hx-target="#course-definitions-content"
                    hx-swap="innerHTML">
                Edit Course Definition
            </button>
            <button type="button"
                    hx-post="@Url.Page(null, "Delete", new { courseDefinitionId = Model.Id })"
                    hx-target="#course-definitions-content"
                    hx-swap="innerHTML"
                    hx-confirm="Delete this course definition?">
                Delete Course Definition
            </button>
        </div>
    </div>

    <div class="course-definition-detail__sections">
        <section class="detail-section">
            <div class="course-definition-detail__section-head">
                <strong>Course Definition</strong>
            </div>
            <div class="kv-grid course-definition-detail__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Code</div>
                    <div class="u-mono">@Model.Code</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Name</div>
                    <div>@Model.Name</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Short name</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.ShortName) ? "-" : Model.ShortName)</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Status</div>
                    <div>@(Model.IsActive ? "Active" : "Disabled")</div>
                </div>
                <div class="kv-grid__row course-definition-detail__description-row">
                    <div class="kv-grid__key">Description</div>
                    <div class="course-definition-detail__description">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "" : Model.Description)
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>