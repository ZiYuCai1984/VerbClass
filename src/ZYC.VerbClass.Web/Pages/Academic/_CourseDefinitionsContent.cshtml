@model ZYC.VerbClass.Web.Pages.Academic.CourseDefinitionsContentModel
@{
    var createDefinitionUrl = Url.Page(null, "Create", new { returnCourseDefinitionId = Model.ActiveCourseDefinitionId });
}

<div class="page-master master-detail-page__master">
    <div class="page-master academic-course-layout">
        <section class="surface master-detail-page__list">
            <div class="surface__head">
                <strong>Course Definitions</strong>
                <span class="u-muted">@Model.Definitions.Length definition(s)</span>
                <button type="button"
                        class="u-push-end"
                        hx-get="@createDefinitionUrl"
                        hx-target="#course-definitions-content"
                        hx-swap="innerHTML"
                        hx-replace-url="@Url.Page(null, null)">
                    New Definition
                </button>
            </div>
            <div class="surface__body scroll-area">
                @if (Model.Definitions.Length == 0)
                {
                    <div class="master-detail-empty">
                        <div class="academic-empty-state">
                            <p>No course definitions have been created yet.</p>
                            <button type="button"
                                    hx-get="@createDefinitionUrl"
                                    hx-target="#course-definitions-content"
                                    hx-swap="innerHTML"
                                    hx-replace-url="@Url.Page(null, null)">
                                Create the first definition
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="record-list course-definition-list">
                        @foreach (var definition in Model.Definitions)
                        {
                            <button type="button"
                                    class="record-list__item course-definition-item@(Model.ActiveCourseDefinitionId == definition.Id ? " is-selected" : string.Empty)"
                                    data-course-definition-item
                                    data-course-definition-id="@definition.Id"
                                    hx-get="@Url.Page(null, "Select", new { courseDefinitionId = definition.Id })"
                                    hx-trigger="click"
                                    hx-target="#course-definition-detail"
                                    hx-swap="innerHTML"
                                    hx-replace-url="@Url.Page(null, null, new { courseDefinitionId = definition.Id })">
                                <div class="record-list__main">
                                    <div class="course-definition-item__title-row">
                                        <strong class="record-list__title u-truncate">@definition.Name</strong>
                                        <span class="tag @(definition.IsActive ? "is-success" : "is-danger")">
                                            @(definition.IsActive ? "Active" : "Disabled")
                                        </span>
                                    </div>
                                    <div class="course-definition-item__meta">
                                        <span class="u-mono">@definition.Code</span>
                                        @if (!string.IsNullOrWhiteSpace(definition.ShortName))
                                        {
                                            <span>@definition.ShortName</span>
                                        }
                                        <span>@definition.OfferingCount offering(s)</span>
                                        @if (definition.LockedOfferingCount > 0)
                                        {
                                            <span>@definition.LockedOfferingCount locked</span>
                                        }
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="surface master-detail-page__detail">
            <div class="surface__head">
                <strong>Course Definition Details</strong>
            </div>
            <div id="course-definition-detail" class="surface__body scroll-area">
                @if (Model.Editor is not null)
                {
                    <partial name="_CourseDefinitionEditor" model="Model.Editor"/>
                }
                else if (Model.SelectedDefinition is not null)
                {
                    <partial name="_CourseDefinitionDetail" model="Model.SelectedDefinition"/>
                }
                else
                {
                    <div class="master-detail-empty">
                        <div class="academic-empty-state">
                            <p>Select a course definition from the list or create a new one.</p>
                            <button type="button"
                                    hx-get="@createDefinitionUrl"
                                    hx-target="#course-definitions-content"
                                    hx-swap="innerHTML"
                                    hx-replace-url="@Url.Page(null, null)">
                                New Definition
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
