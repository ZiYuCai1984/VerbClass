@model ZYC.VerbClass.Web.Pages.Academic.CourseOfferingModalModel
@{
    var submitUrl = Model.IsCreate
        ? Url.Page("/Academic/CourseOfferings", "CreateModal")
        : Url.Page("/Academic/CourseOfferings", "UpdateModal", new { courseOfferingId = Model.CourseOfferingId });
    var courseDefinitionsUrl = Url.Page("/Academic/CourseDefinitions");
    var dayOfWeekValues = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>();
    var selectedCourseDefinitionText = Model.CourseDefinitionOptions
        .FirstOrDefault(x => x.Value == Model.CourseDefinitionId?.ToString())?.Text
        ?? "Course definition not found";
}

@if (!Model.CanCreateOffering)
{
    <div class="modal-state">
        <strong>@Model.TitleText</strong>
        <p>Create a course definition first, then return here to create a course offering.</p>
        <button>
            <a href="@courseDefinitionsUrl">Open Course Definitions</a>
        </button>
    </div>
}
else
{
    <form method="post"
          hx-post="@submitUrl"
          hx-target="#verbclass-modal-content"
          hx-swap="innerHTML"
          class="course-offering-modal">
        <input type="hidden" asp-for="ReturnTo" />
        @if (!Model.IsCreate)
        {
            <input type="hidden" asp-for="CourseDefinitionId" />
        }

        @if (Model.HasErrors)
        {
            <div class="course-offering-modal__summary">
                <ul>
                    @if (Model.SummaryErrors.Count == 0)
                    {
                        <li>Please correct the highlighted fields.</li>
                    }
                    @foreach (var error in Model.SummaryErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="course-offering-modal__body form-layout">
            <section class="form-section">
                <div class="course-offering-modal__header">
                    <strong>@Model.TitleText</strong>
                    <div class="u-muted">
                        @(Model.IsCreate
                            ? "Create a concrete offering for a selected course definition."
                            : "Update term, schedule, and enrollment settings for this course offering.")
                    </div>
                </div>

                <div class="form-grid form-grid--two">
                    @if (Model.IsCreate)
                    {
                        <div class="field">
                            <label class="field__label" asp-for="CourseDefinitionId"></label>
                            <select asp-for="CourseDefinitionId">
                                <option value="">Select a course definition</option>
                                @foreach (var option in Model.CourseDefinitionOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            @foreach (var error in Model.GetErrors(nameof(Model.CourseDefinitionId)))
                            {
                                <div class="course-offering-modal__field-error">@error</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <span class="field__label">Course definition</span>
                            <input value="@selectedCourseDefinitionText" readonly />
                            @foreach (var error in Model.GetErrors(nameof(Model.CourseDefinitionId)))
                            {
                                <div class="course-offering-modal__field-error">@error</div>
                            }
                        </div>
                    }

                    <div class="field">
                        <label class="field__label" asp-for="AcademicYear"></label>
                        <input asp-for="AcademicYear" />
                        @foreach (var error in Model.GetErrors(nameof(Model.AcademicYear)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="TermName"></label>
                        <input asp-for="TermName" autocomplete="off" />
                        @foreach (var error in Model.GetErrors(nameof(Model.TermName)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="ScheduleDayOfWeek"></label>
                        <select asp-for="ScheduleDayOfWeek">
                            <option value="">Not set</option>
                            @foreach (var dayOfWeek in dayOfWeekValues)
                            {
                                <option value="@dayOfWeek">@dayOfWeek</option>
                            }
                        </select>
                        @foreach (var error in Model.GetErrors(nameof(Model.ScheduleDayOfWeek)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="ScheduleStartTime"></label>
                        <input asp-for="ScheduleStartTime" type="time" step="60" asp-format="{0:hh\:mm}" />
                        @foreach (var error in Model.GetErrors(nameof(Model.ScheduleStartTime)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="ScheduleEndTime"></label>
                        <input asp-for="ScheduleEndTime" type="time" step="60" asp-format="{0:hh\:mm}" />
                        @foreach (var error in Model.GetErrors(nameof(Model.ScheduleEndTime)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="ScheduleLocation"></label>
                        <input asp-for="ScheduleLocation" autocomplete="off" />
                        @foreach (var error in Model.GetErrors(nameof(Model.ScheduleLocation)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>
                </div>

                <div class="u-muted">
                    Leave day, start time, and end time empty if the schedule has not been decided yet.
                </div>
            </section>

            <section class="form-section">
                <div class="form-section__title">Enrollment Window</div>
                <div class="form-grid form-grid--two">
                    <div class="field">
                        <label class="field__label" asp-for="EnrollmentStartsAt"></label>
                        <input asp-for="EnrollmentStartsAt"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        @foreach (var error in Model.GetErrors(nameof(Model.EnrollmentStartsAt)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="EnrollmentEndsAt"></label>
                        <input asp-for="EnrollmentEndsAt"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        @foreach (var error in Model.GetErrors(nameof(Model.EnrollmentEndsAt)))
                        {
                            <div class="course-offering-modal__field-error">@error</div>
                        }
                    </div>
                </div>
            </section>
        </div>

        <div class="course-offering-modal__foot">
            <button type="submit" class="is-primary">@Model.SubmitText</button>
            <button type="button" data-modal-close>Cancel</button>
        </div>
    </form>
}
