@using ZYC.VerbClass.Academic.Domain.Shared
@using ZYC.VerbClass.Web.Pages.Academic
@model ZYC.VerbClass.Web.Pages.Academic.CourseOfferingDetailModel
@{
    var editOfferingModalUrl = Url.Page(
        "/Academic/CourseOfferings",
        "EditModal",
        new
        {
            courseOfferingId = Model.Id,
            returnTo = CourseOfferingReturnTargets.Offerings
        });
    var statusTagClass = Model.Status is CourseOfferingStatus.Active or CourseOfferingStatus.Published
        ? "is-success"
        : Model.Status is CourseOfferingStatus.Draft
            ? "is-warning"
            : "is-danger";
}

<div class="course-definition-detail">
    <div class="course-definition-detail__summary">
        <div class="course-definition-detail__title-row">
            <strong class="course-definition-detail__title">@Model.TermLabel</strong>
            <span class="tag @statusTagClass">@Model.Status</span>
            <span class="tag @(Model.IsLocked ? "is-warning" : string.Empty)">
                @(Model.IsLocked ? "Locked" : "Unlocked")
            </span>
        </div>
        <div class="course-definition-detail__subtitle">
            <span class="u-mono">@Model.CourseDefinitionCode</span>
            <span> · @Model.CourseDefinitionName</span>
            @if (!string.IsNullOrWhiteSpace(Model.CourseDefinitionShortName))
            {
                <span> · @Model.CourseDefinitionShortName</span>
            }
        </div>
        <div class="course-definition-detail__meta">
            <span class="tag">@Model.ScheduleLabel</span>
            <span class="tag">@Model.LocationLabel</span>
            <span class="tag">Enrollment @Model.EnrollmentOpenLabel - @Model.EnrollmentCloseLabel</span>
        </div>
        <div class="course-definition-detail__actions">
            <button type="button" data-modal-url="@editOfferingModalUrl">
                Edit Course Offering
            </button>
            <button type="button"
                    hx-post="@Url.Page("/Academic/CourseOfferings", "Delete", new { courseOfferingId = Model.Id })"
                    hx-target="#course-offerings-content"
                    hx-swap="innerHTML"
                    hx-confirm="Delete this course offering?">
                Delete Course Offering
            </button>
        </div>
    </div>

    <div class="course-definition-detail__sections">
        <section class="detail-section">
            <div class="course-definition-detail__section-head">
                <strong>Course Offering</strong>
            </div>
            <div class="kv-grid course-definition-detail__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Academic year</div>
                    <div>@Model.AcademicYear</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Term</div>
                    <div>@Model.TermName</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Status</div>
                    <div>@Model.Status</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Locked</div>
                    <div>@(Model.IsLocked ? "Yes" : "No")</div>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <div class="course-definition-detail__section-head">
                <strong>Schedule</strong>
            </div>
            <div class="kv-grid course-definition-detail__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Schedule</div>
                    <div>@Model.ScheduleLabel</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Location</div>
                    <div>@Model.LocationLabel</div>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <div class="course-definition-detail__section-head">
                <strong>Enrollment Window</strong>
            </div>
            <div class="kv-grid course-definition-detail__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Opens at</div>
                    <div>@Model.EnrollmentOpenLabel</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Closes at</div>
                    <div>@Model.EnrollmentCloseLabel</div>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <div class="course-definition-detail__section-head">
                <strong>Course Definition</strong>
            </div>
            <div class="kv-grid course-definition-detail__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Code</div>
                    <div class="u-mono">@Model.CourseDefinitionCode</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Name</div>
                    <div>@Model.CourseDefinitionName</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Short name</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.CourseDefinitionShortName) ? "-" : Model.CourseDefinitionShortName)</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Status</div>
                    <div>@(Model.IsCourseDefinitionActive ? "Active" : "Disabled")</div>
                </div>
                <div class="kv-grid__row course-definition-detail__description-row">
                    <div class="kv-grid__key">Description</div>
                    <div class="course-definition-detail__description">
                        @(string.IsNullOrWhiteSpace(Model.CourseDefinitionDescription) ? "-" : Model.CourseDefinitionDescription)
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>