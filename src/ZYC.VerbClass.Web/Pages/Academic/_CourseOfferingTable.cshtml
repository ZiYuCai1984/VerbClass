@using ZYC.VerbClass.Academic.Application.Contracts.CourseOfferings
@using ZYC.VerbClass.Academic.Domain.Shared
@model CourseOfferingListItemDto[]
@functions {
    private static string GetOfferingStatusTagClass(CourseOfferingStatus status)
    {
        return status switch
        {
            CourseOfferingStatus.Published => "is-success",
            CourseOfferingStatus.Active => "is-success",
            CourseOfferingStatus.Draft => "is-warning",
            CourseOfferingStatus.Closed => "is-danger",
            CourseOfferingStatus.Cancelled => "is-danger",
            _ => string.Empty
        };
    }

    private static string GetScheduleText(CourseOfferingListItemDto offering)
    {
        return offering.ScheduleDayOfWeek.HasValue
               && offering.ScheduleStartTime.HasValue
               && offering.ScheduleEndTime.HasValue
            ? $"{offering.ScheduleDayOfWeek.Value} {offering.ScheduleStartTime.Value:hh\\:mm}-{offering.ScheduleEndTime.Value:hh\\:mm}"
            : "Schedule not set";
    }
}

<div class="table-wrap">
    <table class="compact-table data-table">
        <thead>
        <tr>
            <th>Term</th>
            <th>Schedule</th>
            <th>Enrollment</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var offering in Model)
        {
            <tr>
                <td class="u-nowrap">
                    @offering.AcademicYear / @offering.TermName
                </td>
                <td>
                    <div class="u-nowrap">
                        @GetScheduleText(offering)
                    </div>
                    <div class="u-muted u-nowrap">
                        @(string.IsNullOrWhiteSpace(offering.ScheduleLocation) ? "Location not set" : offering.ScheduleLocation)
                    </div>
                </td>
                <td>
                    <div class="u-nowrap">@offering.EnrollmentStartsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    <div class="u-muted u-nowrap">@offering.EnrollmentEndsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </td>
                <td>
                    <div class="l-cluster">
                        <span class="tag @GetOfferingStatusTagClass(offering.Status)">
                            @offering.Status
                        </span>
                        <span class="tag @(offering.IsLocked ? "is-warning" : string.Empty)">
                            @(offering.IsLocked ? "Locked" : "Unlocked")
                        </span>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
