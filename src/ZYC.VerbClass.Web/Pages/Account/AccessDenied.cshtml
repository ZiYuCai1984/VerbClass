@page
@model ZYC.VerbClass.Web.Pages.Account.AccessDeniedModel

<section class="login-page l-fill">
    <article class="login-panel login-panel--single">
        <section class="login-panel__main login-panel__main--centered">
            <div class="l-stack login-panel__message">
                <span class="tag is-danger">Access denied</span>
                <h1 class="login-panel__title">You do not have access to this resource.</h1>
                <p class="u-secondary">Your current account does not have permission to open this page.</p>
                <small class="u-muted">If you need access, contact an administrator.</small>
            </div>
        </section>
    </article>
</section>
