@model ZYC.VerbClass.Web.Pages.Admin.AuditLogPartials.AuditLogInfoModel

@if (Model.AuditLog is null)
{
    <div class="master-detail-empty">
        <p>Audit log not found.</p>
    </div>
}
else
{
    <div class="audit-log-info">
        <section class="audit-log-info__summary">
            <div class="audit-log-info__title">
                <strong>@Model.AuditLog.ExecutionTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong>
                <span class="tag">@(string.IsNullOrWhiteSpace(Model.AuditLog.HttpMethod) ? "-" : Model.AuditLog.HttpMethod)</span>
                <span class="tag">@((Model.AuditLog.HttpStatusCode?.ToString()) ?? "-")</span>
                @if (!string.IsNullOrWhiteSpace(Model.AuditLog.Exceptions))
                {
                    <span class="tag is-danger">Exception</span>
                }
            </div>
            <div class="audit-log-info__meta">
                <span class="tag">User: @(string.IsNullOrWhiteSpace(Model.AuditLog.UserName) ? "-" : Model.AuditLog.UserName)</span>
                <span class="tag">Tenant: @(string.IsNullOrWhiteSpace(Model.AuditLog.TenantName) ? "Host" : Model.AuditLog.TenantName)</span>
                <span class="tag">Duration: @Model.AuditLog.ExecutionDuration ms</span>
            </div>
        </section>

        <div class="audit-log-info__sections">
            <section class="detail-section">
                <div class="detail-section__title">Request</div>
                <div class="kv-grid audit-log-info__kv">
                    <div class="kv-grid__row">
                        <div class="kv-grid__key">Url</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.AuditLog.Url) ? "-" : Model.AuditLog.Url)</div>
                    </div>
                    <div class="kv-grid__row">
                        <div class="kv-grid__key">Client IP</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.AuditLog.ClientIpAddress) ? "-" : Model.AuditLog.ClientIpAddress)</div>
                    </div>
                    <div class="kv-grid__row">
                        <div class="kv-grid__key">Application</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.AuditLog.ApplicationName) ? "-" : Model.AuditLog.ApplicationName)</div>
                    </div>
                    <div class="kv-grid__row">
                        <div class="kv-grid__key">Correlation</div>
                        <div class="u-mono">@(string.IsNullOrWhiteSpace(Model.AuditLog.CorrelationId) ? "-" : Model.AuditLog.CorrelationId)</div>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.AuditLog.Exceptions))
            {
                <details class="audit-log-info__disclosure" open>
                    <summary>Exceptions</summary>
                    <div class="audit-log-info__disclosure-body">
                        <pre class="audit-log-info__pre">@Model.AuditLog.Exceptions</pre>
                    </div>
                </details>
            }

            <details class="audit-log-info__disclosure" @(Model.Actions.Length > 0 ? "open" : null)>
                <summary>Actions (@Model.Actions.Length)</summary>
                <div class="audit-log-info__disclosure-body">
                    @if (Model.Actions.Length == 0)
                    {
                        <div class="u-muted">No actions were recorded.</div>
                    }
                    else
                    {
                        @foreach (var action in Model.Actions)
                        {
                            <article class="audit-log-info__entry">
                                <strong class="audit-log-info__entry-service-name">@action.ServiceName</strong>
                                <div class="audit-log-info__entry-meta">
                                    @action.MethodName · @action.ExecutionDuration ms · @action.ExecutionTime.ToLocalTime().ToString("HH:mm:ss")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(action.Parameters))
                                {
                                    <div class="audit-log-info__subsection">
                                        <strong>Parameters</strong>
                                        <pre class="audit-log-info__pre">@action.Parameters</pre>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>
            </details>

            <details class="audit-log-info__disclosure" @(Model.EntityChanges.Length > 0 ? "open" : null)>
                <summary>Entity Changes (@Model.EntityChanges.Length)</summary>
                <div class="audit-log-info__disclosure-body">
                    @if (Model.EntityChanges.Length == 0)
                    {
                        <div class="u-muted">No entity changes were recorded.</div>
                    }
                    else
                    {
                        @foreach (var entityChange in Model.EntityChanges)
                        {
                            <article class="audit-log-info__entry">
                                <strong>@entityChange.Change.ChangeType</strong>
                                <div class="audit-log-info__entry-meta">
                                    @entityChange.Change.EntityTypeFullName
                                </div>
                                <div class="u-muted">
                                    Entity Id: @(string.IsNullOrWhiteSpace(entityChange.Change.EntityId) ? "-" : entityChange.Change.EntityId)
                                </div>

                                @if (entityChange.PropertyChanges.Length > 0)
                                {
                                    <div class="audit-log-info__table-wrap">
                                        <table class="compact-table">
                                            <thead>
                                            <tr>
                                                <th>Property</th>
                                                <th>Original</th>
                                                <th>New</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var propertyChange in entityChange.PropertyChanges)
                                            {
                                                <tr>
                                                    <td>@propertyChange.PropertyName</td>
                                                    <td>@(string.IsNullOrWhiteSpace(propertyChange.OriginalValue) ? "-" : propertyChange.OriginalValue)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(propertyChange.NewValue) ? "-" : propertyChange.NewValue)</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>
            </details>
        </div>
    </div>
}
