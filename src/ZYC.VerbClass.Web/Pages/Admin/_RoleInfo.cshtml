@model ZYC.VerbClass.Web.Pages.Admin.RoleInfoModel

<div class="role-info">
    <section class="role-info__summary">
        <div class="role-info__title">
            <strong class="role-info__name">@Model.Name</strong>
            <span class="tag">@Model.UserCount user(s)</span>
            <span class="tag">@Model.GrantedPermissionCount / @Model.AvailablePermissionCount permission(s)</span>
        </div>

        @if (Model.CanManagePermissions)
        {
            <div class="role-info__actions">
                <button type="button"
                        hx-get="@Url.Page(null, "Edit", new { roleName = Model.Name })"
                        hx-target="#role-manager-content"
                        hx-swap="innerHTML">
                    Edit Permissions
                </button>
            </div>
        }
    </section>

    <div class="role-info__sections">
        <section class="detail-section">
            <div class="detail-section__title">Granted Permissions</div>
            @if (Model.GrantedPermissions.Length == 0)
            {
                <div class="u-muted">No permissions granted.</div>
            }
            else
            {
                <div class="role-info__permissions">
                    @foreach (var permission in Model.GrantedPermissions)
                    {
                        <span class="tag" title="@permission.Name">@permission.DisplayName</span>
                    }
                </div>
            }
        </section>

        <section class="detail-section">
            <div class="detail-section__title">Assigned Users</div>
            @if (Model.AssignedUsers.Length == 0)
            {
                <div class="u-muted">No users are assigned to this role.</div>
            }
            else
            {
                <div class="role-info__users">
                    @foreach (var user in Model.AssignedUsers)
                    {
                        <div class="role-info__user">
                            <strong class="u-truncate">@user.DisplayName</strong>
                            <span class="role-info__user-secondary u-truncate">@user.UserName</span>
                        </div>
                    }
                </div>

                @if (Model.RemainingUserCount > 0)
                {
                    <div class="u-muted">And @Model.RemainingUserCount more user(s).</div>
                }
            }
        </section>
    </div>
</div>
