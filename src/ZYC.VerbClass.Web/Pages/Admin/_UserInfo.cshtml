@model ZYC.VerbClass.Web.Pages.Admin.UserInfoModel

<div class="user-info">
    <section class="user-info__summary">
        <div class="user-info__identity">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarImageSource))
            {
                <img src="@Model.AvatarImageSource"
                     alt="Avatar"
                     class="user-info__avatar"/>
            }
            else
            {
                <div class="user-info__avatar-fallback">
                    @Model.AvatarFallbackText
                </div>
            }

            <div class="user-info__identity-main">
                <div class="user-info__name-row">
                    <strong class="user-info__name">@Model.DisplayName</strong>
                    <span class="tag @(Model.IsActive ? "is-success" : "is-danger")">
                        @(Model.IsActive ? "Active" : "Disabled")
                    </span>
                </div>
                <div class="user-info__username">@Model.UserName</div>
                <div class="user-info__meta">
                    <span class="tag">@(Model.EmailConfirmed ? "Email confirmed" : "Email not confirmed")</span>
                    <span class="tag">@(Model.HasAvatar ? "Avatar uploaded" : "No avatar")</span>
                    <span class="tag">@(Model.Departments.Length == 0 ? "No department" : $"{Model.Departments.Length} department(s)")</span>
                </div>
            </div>
        </div>

        <div class="user-info__actions">
            @if (Model.CanUpdate)
            {
                <form method="post"
                      enctype="multipart/form-data"
                      hx-post="@Url.Page(null, "UploadAvatar")"
                      hx-encoding="multipart/form-data"
                      hx-target="#user-detail"
                      hx-swap="innerHTML"
                      class="user-info__upload-form">
                    <input type="hidden" name="userId" value="@Model.Id"/>
                    <input id="user-avatar-@Model.Id"
                           class="user-info__file-input"
                           type="file"
                           name="avatar"
                           accept="image/jpeg,image/png,image/webp,image/gif"
                           onchange="this.form.requestSubmit()"/>
                    <div class="user-info__action-row">
                        <label for="user-avatar-@Model.Id" class="user-info__file-trigger">Choose Avatar</label>

                        @if (Model.HasAvatar)
                        {
                            <span class="user-info__action-separator"></span>
                        }

                        @if (Model.HasAvatar)
                        {
                            <button type="button"
                                    class="user-info__remove-trigger"
                                    hx-post="@Url.Page(null, "RemoveAvatar")"
                                    hx-target="#user-detail"
                                    hx-swap="innerHTML"
                                    hx-vals='{"userId":"@Model.Id"}'>
                                Remove Avatar
                            </button>
                        }
                    </div>
                    <small class="u-muted">Selecting a file uploads it immediately. JPG, PNG, WEBP, or GIF up to 2 MB.</small>
                </form>
            }

            @if (Model.CanUpdate || Model.CanDelete)
            {
                <div class="user-info__action-row">
                    @if (Model.CanUpdate)
                    {
                        <button type="button"
                                hx-get="@Url.Page(null, "Edit", new { userId = Model.Id })"
                                hx-target="#user-manager-content"
                                hx-swap="innerHTML">
                            Edit User
                        </button>
                    }

                    @if (Model.CanDelete)
                    {
                        <button type="button"
                                hx-post="@Url.Page(null, "Delete", new { userId = Model.Id })"
                                hx-target="#user-manager-content"
                                hx-swap="innerHTML"
                                hx-confirm="Delete this user? This action cannot be undone.">
                            Delete User
                        </button>
                    }
                </div>
            }
        </div>
    </section>

    <div class="user-info__sections">
        <section class="detail-section">
            <div class="detail-section__title">Account</div>
            <div class="kv-grid user-info__kv">
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Id</div>
                    <div class="u-mono user-info__mono">@Model.Id</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Email</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Departments</div>
                    <div>
                        @if (Model.Departments.Length == 0)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <div class="user-info__department-list">
                                @foreach (var department in Model.Departments)
                                {
                                    <div class="user-info__department-row">
                                        <span>@department.Path</span>
                                        @if (department.IsPrimary)
                                        {
                                            <span class="tag is-accent">Primary</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Phone</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</div>
                </div>
                <div class="kv-grid__row">
                    <div class="kv-grid__key">Status</div>
                    <div>@(Model.IsActive ? "Active" : "Disabled")</div>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <div class="detail-section__title">Roles</div>
            @if (Model.Roles.Length == 0)
            {
                <div class="u-muted">No roles assigned.</div>
            }
            else
            {
                <div class="user-info__roles">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="tag">@role</span>
                    }
                </div>
            }
        </section>
    </div>
</div>
